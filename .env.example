# Local-development examples only. Do not use these placeholders in production.
# Generate and store a unique private value in your deployment provider instead.
SECRET_KEY=replace-with-a-long-random-secret

# Local SQLite database; use the provider's private PostgreSQL URL in production.
DATABASE_URL=sqlite:///worldmap.db

# false is for local HTTP development only. Set true for HTTPS deployments.
SESSION_COOKIE_SECURE=false

# Shared rate-limit storage is supported through Flask-Limiter.
# Configure a private Redis-compatible URL in the hosting provider, not in a committed .env file.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Assistant is disabled unless explicitly enabled and configured with a server-side key/model.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=
ASSISTANT_API_KEY=

# Keep uploads private. For durability, attach a persistent disk or implement object storage.
# On Render, only set this after attaching a paid persistent disk at /var/data.
# UPLOAD_FOLDER=/var/data/uploads

# FUTURE / NOT CURRENTLY CONSUMED: setting these alone does not enable the integrations.
# The app has no Socket.IO fanout, Sentry integration, or /api/v1 API-key gate yet.
# REDIS_URL=redis://localhost:6379/0
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/2
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# PUBLIC_API_KEY=
