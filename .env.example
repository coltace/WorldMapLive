SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///worldmap.db
SESSION_COOKIE_SECURE=false
# Optional shared rate-limit storage for multi-worker production deployments.
# Local/test default is in-memory; set a private Redis URI via hosting secrets if needed.
# RATELIMIT_STORAGE_URI=redis://user:password@host:6379/0
# Optional AI assistant; enable only after configuring a server-side provider key/model.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
# Keep uploads private. On Render, set this to /var/data/uploads only after attaching a paid persistent disk at /var/data.
# UPLOAD_FOLDER=/var/data/uploads
